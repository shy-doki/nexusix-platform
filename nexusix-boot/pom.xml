<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.shy.nexusix</groupId>
        <artifactId>nexusix-platform-server</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <groupId>com.shy.nexusix.boot</groupId>
    <artifactId>nexusix-boot</artifactId>

    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.github.ulisesbocchio</groupId>
            <artifactId>jasypt-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shy.nexusix.tenant</groupId>
            <artifactId>nexusix-tenant</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.shy.nexusix.billing</groupId>
            <artifactId>nexusix-billing</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.shy.nexusix.iam</groupId>
            <artifactId>nexusix-iam</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.shy.nexusix.org</groupId>
            <artifactId>nexusix-org</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.shy.nexusix.dynamic</groupId>
            <artifactId>nexusix-dynamic</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.shy.nexusix.system</groupId>
            <artifactId>nexusix-system</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.shy.nexusix.notify</groupId>
            <artifactId>nexusix-notify</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.shy.nexusix.audit</groupId>
            <artifactId>nexusix-audit</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.3.4</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.shy.nexusix.boot.NexusixBootApplication</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>